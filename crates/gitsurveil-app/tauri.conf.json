{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitsurveil",
  "version": "0.1.0",
  "identifier": "io.gitsurveil.app",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/gitsurveild"
    ],
    "shortDescription": "GitHub action-item monitor",
    "longDescription": "Monitors GitHub for the pull requests, reviews, mentions and build failures that need you, and tells you only when something outranks what you are already doing."
  }
}
